# Copy to .env and fill in real values. Never commit .env.

# Required — PostgreSQL connection string
DATABASE_URL=

# Recommended — session signing (use a long random string in production)
SESSION_SECRET=

# Optional — The Blue Alliance API (schedule sync, OPRs, rankings, etc.)
# Get a key: https://www.thebluealliance.com/account
TBA_API_KEY=

# Optional — outbound email (invites, etc.)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Strikescout <noreply@example.com>

# Optional — public base URL for links (defaults inferred in dev)
# APP_ORIGIN=
# VITE_ORIGIN=

# Optional — server bind (defaults: PORT 5050 on Windows, 5000 elsewhere; HOST 0.0.0.0 on Linux)
# PORT=
# HOST=
